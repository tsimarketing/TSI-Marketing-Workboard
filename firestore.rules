rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /members/{memberId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == memberId;
      allow delete: if false;
    }

    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == request.auth.uid;
    }
  }
}
